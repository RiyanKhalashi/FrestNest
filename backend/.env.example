# Copy to .env for local development. Never commit the real .env.
DATABASE_URL="postgresql://freshnest:freshnest@localhost:5432/freshnest?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
WEB_ORIGIN="http://localhost:3000"  # comma-separated list is allowed
