{
  "appId": "com.freshnest.app",
  "appName": "FreshNest",
  "webDir": "www",
  "server": {
    "url": "https://freshnest-bd.vercel.app",
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0B3B24",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0B3B24",
      "style": "DARK",
      "overlaysWebView": false
    }
  }
}
