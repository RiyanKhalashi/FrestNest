{
  "name": "freshnest",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:start": "./scripts/db.sh start",
    "db:stop": "./scripts/db.sh stop",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "npm run db:start; (npm run dev -w backend & npm run dev -w frontend & wait)",
    "seed": "npm run seed -w backend",
    "typecheck": "npm run typecheck -w backend && npx -w frontend tsc --noEmit",
    "demo": "npm run demo -w backend",
    "test": "npm run test -w backend"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "fsevents": false
  }
}
